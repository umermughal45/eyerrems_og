  batch              LeadImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@index([resolvedDealerId])
  @@index([createdLeadId])
}

model Client {
  id                  String            @id @default(uuid())
