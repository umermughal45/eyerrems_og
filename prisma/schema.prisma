model Voucher {
  id                String               @id @default(uuid())
  voucherNumber     String               @unique
  type              String               // BPV, BRV, CPV, CRV, JV
  date              DateTime
  postingDate       DateTime?            // Actual posting date (may differ from voucher date)
  paymentMethod     String               // Cheque, Transfer, Online, Cash
  accountId         String               // Primary account (bank/cash for payment/receipt vouchers)
  expenseCategoryId String?
  description       String?
  referenceNumber   String?              // Cheque number, transaction reference, etc.
  amount            Float                // Total amount (calculated from lines)
  status            String               @default("draft") // draft, submitted, approved, posted, reversed
  attachments       Json?
  preparedByUserId  String?
  approvedByUserId  String?
  postedByUserId    String?
  postedAt          DateTime?
  journalEntryId    String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  dealId            String?
  // Property/Unit linkage (mandatory for property-related vouchers)
  propertyId        String?
  unitId            String?
  // Payee entity linkage (for BPV/CPV - who we're paying)
  payeeType         String?              // Vendor, Owner, Agent, Contractor, Tenant, Client, Dealer, Employee
  payeeId           String?              // ID of the payee entity
  // Reversal support
  reversedVoucherId String?              // Reference to original voucher if this is a reversal
  reversedByUserId  String?
  reversedAt        DateTime?
  // Legacy fields maintained for backward compatibility
  account           Account              @relation(fields: [accountId], references: [id])
  approvedBy        User?                @relation("VoucherApprovedBy", fields: [approvedByUserId], references: [id])
  deal              Deal?                @relation("VoucherDeal", fields: [dealId], references: [id])
  expenseCategory   TransactionCategory? @relation(fields: [expenseCategoryId], references: [id])
  journalEntry      JournalEntry?        @relation("JournalEntryVouchers", fields: [journalEntryId], references: [id])
  preparedBy        User?                @relation("VoucherPreparedBy", fields: [preparedByUserId], references: [id])
  property          Property?            @relation("VoucherProperty", fields: [propertyId], references: [id])
  unit              Unit?                @relation("VoucherUnit", fields: [unitId], references: [id])
  reversedVoucher   Voucher?             @relation("VoucherReversal", fields: [reversedVoucherId], references: [id])
  reversalVouchers  Voucher[]            @relation("VoucherReversal")
  lines             VoucherLine[]
  financialOperations FinancialOperation[] @relation("FinancialOperationVoucher")

  @@index([dealId])
  @@index([propertyId])
  @@index([unitId])
  @@index([status])
  @@index([type])
  @@index([date])
  @@index([postingDate])
  @@index([payeeType, payeeId])
  @@index([reversedVoucherId])
}

model VoucherLine {
  id                String   @id @default(uuid())
  voucherId         String
  accountId         String   // Account for this line item
  debit             Float    @default(0)
  credit            Float    @default(0)
  description       String?
  // Property/Unit allocation (optional for line-level allocation)
  propertyId        String?
  unitId            String?
  // Reference to entity account binding if applicable
  entityAccountBindingId String?
  voucher           Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account           Account  @relation("VoucherLineAccount", fields: [accountId], references: [id])
  property          Property? @relation("VoucherLineProperty", fields: [propertyId], references: [id])
  unit              Unit?    @relation("VoucherLineUnit", fields: [unitId], references: [id])

  @@index([voucherId])
  @@index([accountId])
  @@index([propertyId])
  @@index([unitId])
}

model Commission {
  id             String   @id @default(uuid())
  dealerId       String?
  saleId         String?
  rate           Float    @default(0)
  amount         Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  commissionType String   @default("percentage")
  dealer         Dealer?  @relation(fields: [dealerId], references: [id])
  sale           Sale?    @relation(fields: [saleId], references: [id])

  // Extended commission structure for deal-based brokerage and reporting
  dealId                String?
  propertyId            String?
  commissionBase        Float?
  grossCommission       Float?
  taxDeduction          Float?
  netCommission         Float?
  status                String?   @default("EARNED")
  milestoneInstallmentId String?

  deal                 Deal?           @relation(fields: [dealId], references: [id])
  property             Property?       @relation(fields: [propertyId], references: [id])
  milestoneInstallment DealInstallment? @relation("CommissionMilestoneInstallment", fields: [milestoneInstallmentId], references: [id])

  @@index([dealerId])
  @@index([dealId])
  @@index([propertyId])
  @@index([status])
}

model Account {
  id                        String                 @id @default(uuid())
  code                      String                 @unique
  name                      String
  type                      String
  description               String?
  isActive                  Boolean                @default(true)
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  parentId                  String?
  isPostable                Boolean                @default(true)
  cashFlowCategory          String?
  level                     Int                    @default(1)
  accountType               String                 @default("Posting")
  normalBalance             String                 @default("Debit")
  trustFlag                 Boolean                @default(false)
  parent                    Account?               @relation("AccountHierarchy", fields: [parentId], references: [id])
  children                  Account[]              @relation("AccountHierarchy")
  accountAliases            AccountAlias[]
  invoiceIncomeAccounts     Invoice[]              @relation("InvoiceIncomeAccount")
  invoiceTenantAccounts     Invoice[]              @relation("InvoiceTenantAccount")
  journalLines              JournalLine[]
  creditLedgerEntries       LedgerEntry[]          @relation("LedgerEntryCreditAccount")
  debitLedgerEntries        LedgerEntry[]          @relation("LedgerEntryDebitAccount")
  creditTransactions        Transaction[]          @relation("TransactionCreditAccount")
  debitTransactions         Transaction[]          @relation("TransactionDebitAccount")
  transactionCategoryCredit TransactionCategory[]  @relation("TransactionCategoryCredit")
  transactionCategoryDebit  TransactionCategory[]  @relation("TransactionCategoryDebit")
  vouchers                  Voucher[]
  voucherLines              VoucherLine[]          @relation("VoucherLineAccount")
  tenantAdvancePayments     TenantPayment[]        @relation("TenantPaymentAdvanceAccount")
  tenantBankPayments        TenantPayment[]        @relation("TenantPaymentBankAccount")
  tenantReceivablePayments  TenantPayment[]        @relation("TenantPaymentReceivableAccount")
  entityAccountBindings     EntityAccountBinding[]

  @@index([type])
  @@index([isActive])
  @@index([parentId])
}

model JournalEntry {
  id               String          @id @default(uuid())
  voucherNo        String?         @unique
  date             DateTime
  description      String?
  narration        String?
  status           String          @default("posted")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  entryNumber      String          @unique
  attachments      Json?
  preparedByUserId String?
  approvedByUserId String?
  dealReceipts     DealReceipt?    @relation("DealReceiptJournalEntry")
  invoices         Invoice[]       @relation("JournalEntryInvoices")
  approvedBy       User?           @relation("JournalApprovedBy", fields: [approvedByUserId], references: [id])
  preparedBy       User?           @relation("JournalPreparedBy", fields: [preparedByUserId], references: [id])
  lines            JournalLine[]
  transactions     Transaction[]   @relation("JournalEntryTransactions")
