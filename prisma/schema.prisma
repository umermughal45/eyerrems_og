model CRMActivity {
  id           String    @id @default(uuid())
  leadId       String?
  clientId     String?
  dealId       String?
  type         String
  title        String
  description  String?
  activityDate DateTime  @default(now())
  dueDate      DateTime?
  status       String    @default("pending")
  priority     String?
