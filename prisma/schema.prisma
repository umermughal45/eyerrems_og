  tenant              Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([date])
  @@index([status])
  @@index([tenantId])
  @@map("tenant_payments")
}

model MaintenanceTicket {
  id              String                @id @default(uuid())
  ticketNumber    String?               @unique
  tenantId        String
